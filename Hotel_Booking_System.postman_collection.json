    {
      "name": "04 - Bookings",
      "description": "JWT-protected booking creation, retrieval, and cancellation APIs.",
      "item": [
        {
          "name": "[POST] Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/bookings",
            "description": "Create a PENDING booking for the authenticated user. Saves data.bookingReference automatically.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": \"{{roomId}}\",\n  \"checkIn\": \"2026-11-10\",\n  \"checkOut\": \"2026-11-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.bookingReference) {",
                  "    pm.collectionVariables.set(\"bookingReference\", response.data.bookingReference);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "[GET] Get My Bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/bookings/my",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "[POST] Get Booking Details",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/details",
            "description": "Retrieve an owned booking by its public UUID reference.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingReference\": \"{{bookingReference}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "[PATCH] Cancel Booking",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/cancel",
            "description": "Cancel an owned booking using its public UUID reference.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingReference\": \"{{bookingReference}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "05 - Payments",
      "description": "JWT-protected dummy payment flow using public booking and payment UUID references.",
      "item": [
        {
          "name": "[POST] Initiate Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/payments/initiate",
            "description": "Create or retrieve the PENDING payment for an owned booking.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingReference\": \"{{bookingReference}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.paymentReference) {",
                  "    pm.collectionVariables.set(\"paymentReference\", response.data.paymentReference);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "[POST] Submit Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/payments/submit",
            "description": "Submit a dummy transaction ID using the public payment reference.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentReference\": \"{{paymentReference}}\",\n  \"transactionId\": \"S 6789ABcd\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "[POST] Get Payment For Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/payments/booking",
            "description": "Retrieve payment data for an owned booking reference.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingReference\": \"{{bookingReference}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
