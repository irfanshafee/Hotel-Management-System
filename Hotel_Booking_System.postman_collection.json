    },
    {
      "name": "04 - Bookings",
      "description": "JWT-protected booking creation, retrieval, and cancellation APIs.",
      "item": [
        {
          "name": "[POST] Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/bookings",
            "description": "Create a PENDING booking for the authenticated user. Saves data.bookingId automatically.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": \"{{roomId}}\",\n  \"checkIn\": \"2026-11-10\",\n  \"checkOut\": \"2026-11-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.bookingId) {",
                  "    pm.collectionVariables.set(\"bookingId\", response.data.bookingId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "[GET] Get My Bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/bookings/my",
